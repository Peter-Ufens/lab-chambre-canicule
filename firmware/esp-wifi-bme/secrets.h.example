#pragma once

// Copier ce fichier vers secrets.h (meme dossier que le .ino).
// secrets.h n'est PAS versionne (mot de passe Wi-Fi).
// ESP32 = 2,4 GHz seulement. Si REMPLACE_SSID_2_4GHZ refuse, on fera un scan.

#define WIFI_SSID "REMPLACE_SSID_2_4GHZ"
#define WIFI_PASS "REMPLACE_MOI"

// IPv4 du Pi (<hostname-pi>.home tombe souvent en IPv6, ESP32 = IPv4).
// Si le DHCP du Pi change, on change CETTE ligne. Pas les IP des ESP.
#define COLLECTOR_HOST "<IP-du-Pi>"
#define COLLECTOR_PORT 8080
